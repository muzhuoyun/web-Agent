{
  "id": "adult-guard",
  "name": "色情内容屏蔽",
  "version": "1.3.0",
  "icon": "🛡️",
  "description": "检测网页中的色情内容并自动屏蔽，屏蔽后自动挖掘新关键词更新词库，反复误命中的关键词自动移入无关词列表",
  "triggers": [
    "page-load"
  ],
  "systemPrompt": "你是一个内容审核助手。判断以下文字是否包含色情内容，只回答 true 或 false。",
  "configSchema": {
    "type": "object",
    "title": "插件配置",
    "properties": {
      "systemPrompt": {
        "type": "string",
        "format": "textarea",
        "title": "审核提示词"
      },
      "sensitivity": {
        "type": "string",
        "title": "敏感度",
        "enum": [
          "低",
          "中",
          "高"
        ],
        "default": "中"
      },
      "keywords": {
        "type": "array",
        "title": "追加关键词（可选）",
        "items": {
          "type": "string",
          "title": "关键词"
        },
        "options": {
          "disable_array_reorder": true
        },
        "default": [],
        "description": "默认内置 400 个敏感词（中/英/日/韩，代码内固定），此处可追加自己的词。另有自动学习词库：页面被屏蔽后自动用 LLM 挖掘新词，存本机（ag_learned_keywords），三者联合判断。"
      }
    }
  },
  "valid": true,
  "errors": [],
  "sensitivity": "高",
  "keywords": []
}